# Dependencies
node_modules/

# Expo
.expo/
dist/

# Build artifacts
*.apk
*.aab
*.keystore

# Environment variables
.env

# Ignore agent internal skills and artifacts (not project files)
.agents/
.artifacts/

# Android specific (keep the source, ignore build outputs)
android/app/build/
android/.gradle/
android/build/
android/captures/
android/.navigation/
# JS bundle: gjenerohet nga Gradle (createBundle<Variant>JsAndAssets) dhe
# kompajlohet ne Hermes bytecode. Mos e vendos manualisht ketu!
android/app/src/main/assets/*.bundle
android/app/src/main/assets/*.hbc

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Build logs and temp files
*.err
*.log
*pid.txt
*.pid

# Build outputs (gjenerohen nga build_android.bat / npm run build:*)
build_*.txt
bundle_*.txt
gen_*.txt
expo_cfg.txt
*.bak
