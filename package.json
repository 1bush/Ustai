{
  "name": "ustai-app",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "icons": "python scripts/generate-icons.py",
    "clean:android": "cd android && gradlew.bat --stop && gradlew.bat clean",
    "clean:full": "npx rimraf .expo android/.gradle android/app/build android/build node_modules/.cache && npm run clean:android",
    "build:android": "npm run clean:android && npm run bundle:android && cd android && gradlew.bat assembleRelease --no-daemon",
    "build:apk": "npm run build:android",
    "build:apk:debug": "npm run bundle:android && cd android && gradlew.bat assembleDebug --no-daemon",
    "bundle:android": "npx expo export:embed --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@stripe/stripe-react-native": "0.64.0",
    "expo": "^57.0.11",
    "expo-asset": "^57.0.9",
    "expo-constants": "^57.0.9",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.12",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "^57.0.5",
    "expo-location": "~57.0.12",
    "expo-notifications": "^57.0.9",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "^57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "pocketbase": "^0.21.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-signature-canvas": "^4.7.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webview": "13.16.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/cli": "^57.0.17",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "typescript": "~6.0.3"
  }
}
