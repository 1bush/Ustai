{
  "name": "ustai-app",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "build:android": "npm run prebuild && cd android && gradlew assembleRelease",
    "build:android-debug": "npm run prebuild && cd android && gradlew assembleDebug",
    "build:apk": "npm run clean:full && npm run prebuild && cd android && gradlew assembleRelease --no-daemon",
    "clean:android": "cd android && gradlew --stop && gradlew clean",
    "clean:full": "npx rimraf .expo android/.gradle android/app/build android/build node_modules/.cache && npm run clean:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.0.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@stripe/stripe-react-native": "0.38.6",
    "expo": "^57.0.11",
    "expo-asset": "^57.0.9",
    "expo-constants": "^57.0.9",
    "expo-device": "~6.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-image-picker": "~15.0.7",
    "expo-keep-awake": "~13.0.2",
    "expo-linking": "^57.0.5",
    "expo-location": "~17.0.1",
    "expo-notifications": "^57.0.9",
    "expo-print": "~12.8.1",
    "expo-sharing": "~12.0.1",
    "expo-splash-screen": "^57.0.5",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "pocketbase": "^0.21.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "^0.86.2",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-maps": "1.14.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "~3.31.1",
    "react-native-signature-canvas": "^4.7.2",
    "react-native-svg": "^15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webview": "^13.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.45",
    "babel-plugin-module-resolver": "^5.0.3",
    "typescript": "~5.3.3"
  }
}
