// ⚠️ ARKIV — jo për përdorim. Ruan backup-n e lidhjes reale me PocketBase.
//
// Për 0.21.x AsyncAuthStore NUK EKZISTON (u hoq në 0.22). Kopjimi i këtij
// skedari mbi pocketbase.ts do të japë:
//   TypeError: undefined is not an object (nuk ka constructor)
// Për të rikthyer serverin, shkruaj lidhjen nga e zera ose përdor
// pocketbase.createAuthStore() të versionit 0.21+.
import PocketBase from 'pocketbase';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { Platform } from 'react-native';

const DEFAULT_URL = Platform.OS === 'android' ? 'http://10.0.2.2:8090' : 'http://127.0.0.1:8090';
const POCKETBASE_URL = process.env.EXPO_PUBLIC_POCKETBASE_URL || DEFAULT_URL;

// Krijojmë një AsyncAuthStore që sinkronizohet automatikisht me AsyncStorage
const store = new AsyncAuthStore({
  save: async (batch) => AsyncStorage.setItem('pb_auth', batch),
  clear: async () => AsyncStorage.removeItem('pb_auth'),
});

export const pb = new PocketBase(POCKETBASE_URL, store);

/**
 * Promise që tregon kur është restauruar sesioni fillestar.
 * App.tsx duhet ta presë këtë përpara se të vendosë për ridrejtimin
 * e sesionit — zgjidh çështjen "flash of logged-out" dhe nisjen e
 * heshtur (anti-pattern "fire-and-forget"). Aplikuar sipas
 * skill-it `react-native-patterns` (state serveri duhet të inicohet
 * në mënyrë të kontrolluar) dhe `error-handling` (asnjë gabim në heshtje).
 */
export const pbReady: Promise<void> = (async () => {
  try {
    const data = await AsyncStorage.getItem('pb_auth');
    if (data) {
      console.log('Duke restauruar sesionin...');
      // AsyncAuthStore saves a JSON string of { token, model }
      try {
        const parsed = JSON.parse(data);
        if (parsed.token && parsed.model) {
          pb.authStore.save(parsed.token, parsed.model);
          console.log('Sesioni u restaurua me sukses.');
        } else {
          pb.authStore.loadFromCookie(data);
        }
      } catch (e) {
        pb.authStore.loadFromCookie(data);
      }
    }
  } catch (e) {
    console.error('Deshtoi rikthimi i sesionit te PocketBase:', e);
  }
})();

export default pb;
