# PocketBase Configuration — SERVERI ESHTE HEQUR (mock lokal)
# src/lib/pocketbase.ts eshte nje mock qe nuk ben thirrje rrjeti, prandaj
# EXPO_PUBLIC_POCKETBASE_URL nuk perdoret me. Per ta rikthyer serverin real:
#   Copy-Item src/lib/pocketbase.ts.REAL.BAK src/lib/pocketbase.ts -Force
# Per telefon real: perdor IP-ne e kompjuterit ne te njejtin rrjet (psh. http://192.168.1.15:8090)
# Per emulator Android: perdor http://10.0.2.2:8090
EXPO_PUBLIC_POCKETBASE_URL=

# AI Services — AI LOKALE / OFFLINE (Ollama u hoq)
# Nuk nevojitet asnje server AI dhe as API key: src/lib/localAI.ts kthen
# te dhena demo lokale, pa thirrje rrjeti.
# (Historikisht: Groq cloud + Ollama lokal — te dyja te hequra.)
# EXPO_PUBLIC_GROQ_API_KEY=
# EXPO_PUBLIC_OLLAMA_URL=http://localhost:11434
# EXPO_PUBLIC_OLLAMA_MODEL=llama3.2-vision:11b

# Map Services (WP Go Map token - vendos token-in tend)
EXPO_PUBLIC_WP_GO_MAP_TOKEN=

# Payment Services (Stripe) - publishable key publique
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
